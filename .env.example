APP_NAME="Pemilihan OSIS SMPN 2 BALUNG"
# development = tampilkan error; production = sembunyikan error, tulis ke storage/logs/error.log
APP_ENV=production

SCHOOL_NAME="SMPN 2 BALUNG"
SCHOOL_REGION="Kabupaten Jember"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=osis_voting
DB_USER=root
DB_PASS=

# Idle timeout sesi admin (detik)
SESSION_LIFETIME=7200
# Maksimal ukuran foto kandidat (byte)
UPLOAD_MAX_SIZE=2097152
# Maksimal baris per import DPT
IMPORT_MAX_ROWS=1000
