Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Semua request diarahkan ke folder public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Lindungi file sensitif jika mod_rewrite tidak aktif
<FilesMatch "^\.env|\.(md|sql|log|xlsx|csv)$">
    Require all denied
</FilesMatch>
